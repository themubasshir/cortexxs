# Cortexx production env — copy to cortexx-app/.env on server, fill values.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
# Domain-root install: empty. Subdir (e.g. /site): APP_BASE_PATH=/site
APP_BASE_PATH=

# Hostinger SMTP (hPanel → Emails → Email Accounts → Configuration)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=hello@yourdomain.com
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM=hello@yourdomain.com
MAIL_FROM_NAME="Cortexx"
MAIL_TO=info@yourdomain.com

# Random 64-char hex — generate: php -r "echo bin2hex(random_bytes(32));"
CSRF_SECRET=
